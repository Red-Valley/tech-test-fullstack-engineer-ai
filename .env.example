# Copy this file to .env.local and fill it in. .env.local is gitignored - never commit a real key.

# Required for the AI chat. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: model used by the chat (default: claude-opus-5-5).
# claude-haiku-5-5 is the cheapest/fastest option, claude-sonnet-5-5 sits in between.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: where the SQLite file lives (default: ./data/games.db).
# DATABASE_PATH=./data/games.db
