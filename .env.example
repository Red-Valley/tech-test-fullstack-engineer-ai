# Selects which LLM provider the chat endpoint uses.
# Valid values: "anthropic" or "openai". Defaults to "anthropic" when unset.
LLM_PROVIDER=

# API key for Anthropic (Claude). Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# API key for OpenAI. Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
