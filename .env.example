# Copy to .env.local and fill in.
# LLM provider: groq (default, has a free tier) or anthropic.
LLM_PROVIDER=groq
# Key for the provider above. Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=
# Only needed with LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional. Defaults: openai/gpt-oss-120b (groq), claude-haiku-5-5 (anthropic).
LLM_MODEL=
# Optional. Defaults to data/games.db. Evals use data/eval.db.
DB_PATH=data/games.db
